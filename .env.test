# === Advocatus IA — Variáveis de Ambiente para Testes Playwright ===
# Edita estas portas se tiveres conflitos com outros serviços locais

# --- Porta da API NestJS ---
API_PORT=4000

# --- Base de Dados (Supabase Local) ---
# Porta do PostgreSQL do Supabase CLI local
TEST_DB_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- JWT (Chave local do Supabase) ---
TEST_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters-long"
