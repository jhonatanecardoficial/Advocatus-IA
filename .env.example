# === Advocatus IA — Environment Variables ===
# Copiar este ficheiro para .env e preencher os valores

# --- Database (Supabase) ---
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[supabase-anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[supabase-service-role-key]"

# --- API ---
PORT=4000
NODE_ENV=development
JWT_SECRET="[gerar com: openssl rand -hex 32]"
ALLOWED_ORIGINS="http://localhost:3000"

# --- OpenAI (IA / RAG) ---
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-large"

# --- Redis (BullMQ / Cache) ---
REDIS_URL="redis://localhost:6379"

# --- Email (Resend) ---
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@advocatus-ia.pt"

# --- Storage ---
STORAGE_BUCKET="advocatus-documents"

# --- Assinaturas Digitais ---
# Autenticação.gov (CMD/Cartão de Cidadão) — Fase 2
AUTENTICACAO_GOV_CLIENT_ID=""
AUTENTICACAO_GOV_CLIENT_SECRET=""
MULTICERT_API_KEY=""

# --- E-Fatura (Autoridade Tributária) ---
# Credenciais para integração futura com o e-fatura via API AT
EFATURA_API_CLIENT_ID="[client-id]"
EFATURA_API_CLIENT_SECRET="[client-secret]"
EFATURA_API_NIF="[contribuinte]"
EFATURA_API_PASSWORD="[senha]"
EFATURA_API_URL="https://servicos.portaldasfinancas.gov.pt"
