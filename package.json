{
  "name": "advocatus-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma SaaS de gestão jurídica com IA para o mercado português",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "pnpm test:unit && pnpm test:api",
    "test:unit": "pnpm --filter @advocatus/api test",
    "test:api": "playwright test --config playwright.config.ts tests/api",
    "test:web": "playwright test --config playwright.web.config.ts tests/frontend-phase6.spec.ts",
    "type-check": "turbo type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "dotenv": "^17.3.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.18.3",
  "dependencies": {
    "jose": "^6.1.3"
  }
}
