generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                     String           @id @default(cuid())
  slug                   String           @unique
  name                   String
  plan                   TenantPlan       @default(SOLO)
  logoUrl                String?
  settings               Json             @default("{}")
  billingStatus          BillingStatus    @default(TRIAL)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  address                String?
  city                   String?
  commercialRegistration String?
  email                  String?
  nif                    String?
  phone                  String?
  postalCode             String?
  auditLogs              AuditLog[]
  clients                Client[]
  documents              Document[]
  expenses               Expense[]
  invoiceSeries          InvoiceSeries[]
  invoices               Invoice[]
  legalTemplates         LegalTemplate[]
  matters                Matter[]
  messages               Message[]
  portalAccesses         PortalAccess[]
  signedDocuments        SignedDocument[]
  tasks                  Task[]
  users                  User[]

  @@map("tenants")
}

model User {
  id                 String         @id @default(cuid())
  tenantId           String
  email              String
  name               String
  barNumber          String?
  role               UserRole       @default(ADVOGADO)
  avatarUrl          String?
  mfaEnabled         Boolean        @default(false)
  mfaSecret          String?
  lastLoginAt        DateTime?
  passwordHash       String?
  supabaseUserId     String?        @unique
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  auditLogs          AuditLog[]
  expenses           Expense[]
  sentMessages       Message[]
  createdPortalLinks PortalAccess[]
  assignedTasks      Task[]         @relation("TaskAssignee")
  createdTasks       Task[]         @relation("TaskCreator")
  timeEntries        TimeEntry[]
  tenant             Tenant         @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Client {
  id                  String     @id @default(cuid())
  tenantId            String
  type                ClientType @default(SINGULAR)
  name                String
  nif                 String?
  email               String?
  phone               String?
  address             String?
  conflictCheckStatus String?
  gdprConsentAt       DateTime?
  notes               String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?
  tenant              Tenant     @relation(fields: [tenantId], references: [id])
  invoices            Invoice[]
  matters             Matter[]

  @@unique([tenantId, nif])
  @@index([tenantId])
  @@map("clients")
}

model Matter {
  id              String           @id @default(cuid())
  tenantId        String
  clientId        String
  responsibleId   String?
  title           String
  type            MatterType       @default(OUTRO)
  status          MatterStatus     @default(ATIVO)
  courtReference  String?
  citiusReference String?
  opposingParty   String?
  opposingCounsel String?
  description     String?
  openedAt        DateTime         @default(now())
  deadlineAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  documents       Document[]
  expenses        Expense[]
  invoices        Invoice[]
  client          Client           @relation(fields: [clientId], references: [id])
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  messages        Message[]
  portalAccesses  PortalAccess[]
  signedDocuments SignedDocument[]
  tasks           Task[]
  timeEntries     TimeEntry[]

  @@index([tenantId])
  @@map("matters")
}

model Document {
  id                 String             @id @default(cuid())
  matterId           String
  tenantId           String
  uploadedById       String?
  filename           String
  mimeType           String
  storagePath        String
  sizeBytes          Int
  version            Int                @default(1)
  parentVersionId    String?
  signatureType      SignatureType      @default(NONE)
  signatureStatus    SignatureStatus?
  signatureProvider  SignatureProvider?
  signatureMetadata  Json?
  ltaPreserved       Boolean            @default(false)
  tags               String[]
  metadata           Json               @default("{}")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  isSharedWithClient Boolean            @default(false)
  matter             Matter             @relation(fields: [matterId], references: [id])
  parentVersion      Document?          @relation("DocumentVersions", fields: [parentVersionId], references: [id])
  versions           Document[]         @relation("DocumentVersions")
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  signedDocuments    SignedDocument[]

  @@index([tenantId])
  @@map("documents")
}

model SignedDocument {
  id                 String    @id @default(cuid())
  tenantId           String
  matterId           String?
  documentId         String?
  originalFilePath   String
  signedFilePath     String?
  signerName         String?
  signerNif          String?
  signatureTimestamp DateTime  @default(now())
  signatureValid     Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  document           Document? @relation(fields: [documentId], references: [id])
  matter             Matter?   @relation(fields: [matterId], references: [id])
  tenant             Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("signed_documents")
}

model TimeEntry {
  id           String   @id @default(cuid())
  matterId     String
  userId       String
  tenantId     String
  description  String
  hours        Decimal  @db.Decimal(5, 2)
  ratePerHour  Decimal? @db.Decimal(10, 2)
  billable     Boolean  @default(true)
  activityDate DateTime @db.Date
  invoiceId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  taskId       String?
  matter       Matter   @relation(fields: [matterId], references: [id])
  task         Task?    @relation(fields: [taskId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("time_entries")
}

model Expense {
  id          String          @id @default(cuid())
  tenantId    String
  matterId    String
  userId      String
  taskId      String?
  description String
  category    ExpenseCategory @default(OUTRO)
  amount      Decimal         @db.Decimal(10, 2)
  date        DateTime        @db.Date
  billable    Boolean         @default(true)
  invoiceId   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  matter      Matter          @relation(fields: [matterId], references: [id])
  task        Task?           @relation(fields: [taskId], references: [id])
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  user        User            @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("expenses")
}

model Invoice {
  id          String        @id @default(cuid())
  matterId    String
  clientId    String
  tenantId    String
  reference   String        @unique
  amount      Decimal       @db.Decimal(10, 2)
  vatRate     Decimal       @default(23) @db.Decimal(5, 2)
  total       Decimal       @db.Decimal(10, 2)
  status      InvoiceStatus @default(DRAFT)
  dueDate     DateTime?
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  atcud       String?
  certDate    DateTime?
  hash        String?
  hashControl String?
  isCertified Boolean       @default(false)
  keyVersion  Int           @default(1)
  number      Int           @default(0)
  series      String        @default("A")
  signature   String?
  client      Client        @relation(fields: [clientId], references: [id])
  matter      Matter        @relation(fields: [matterId], references: [id])
  tenant      Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("invoices")
}

model InvoiceSeries {
  id         String   @id @default(cuid())
  tenantId   String
  code       String
  type       String   @default("FT")
  nextNumber Int      @default(1)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("invoice_series")
}

model Task {
  id               String       @id @default(cuid())
  matterId         String
  assignedToId     String?
  createdById      String
  tenantId         String
  title            String
  description      String?
  type             TaskType     @default(OUTRO)
  priority         TaskPriority @default(MEDIA)
  dueAt            DateTime?
  completedAt      DateTime?
  notificationSent Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  penaltyLimitAt   DateTime?
  expenses         Expense[]
  assignedTo       User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy        User         @relation("TaskCreator", fields: [createdById], references: [id])
  matter           Matter       @relation(fields: [matterId], references: [id])
  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  timeEntries      TimeEntry[]

  @@index([tenantId])
  @@map("tasks")
}

model Message {
  id               String    @id @default(cuid())
  matterId         String
  senderId         String?
  tenantId         String
  contentEncrypted String
  readAt           DateTime?
  createdAt        DateTime  @default(now())
  isFromClient     Boolean   @default(false)
  matter           Matter    @relation(fields: [matterId], references: [id])
  sender           User?     @relation(fields: [senderId], references: [id])
  tenant           Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("messages")
}

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String?
  action       String
  resourceType String
  resourceId   String
  oldValue     Json?
  newValue     Json?
  ipAddress    String?
  userAgent    String?
  timestamp    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  user         User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("audit_logs")
}

model LegalDocument {
  id          String                 @id @default(cuid())
  source      String
  type        LegalDocumentType
  title       String
  reference   String?
  content     String
  publishedAt DateTime?
  url         String?
  ingestedAt  DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  embedding   Unsupported("vector")?

  @@map("legal_documents")
}

model PortalAccess {
  id        String   @id @default(cuid())
  tenantId  String
  matterId  String
  token     String   @unique
  expiresAt DateTime
  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [createdBy], references: [id])
  matter    Matter   @relation(fields: [matterId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([token])
  @@map("portal_accesses")
}

model LegalTemplate {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  description  String?
  category     String
  content      String
  placeholders String[]
  aiPrompt     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("legal_templates")
}

enum UserRole {
  ADMIN
  SOCIO
  ADVOGADO
  ESTAGIARIO
  SECRETARIA
  CLIENTE
}

enum TenantPlan {
  SOLO
  PEQUENO
  ESCRITORIO
  ENTERPRISE
}

enum BillingStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum ClientType {
  SINGULAR
  COLETIVO
}

enum MatterType {
  CIVEL
  PENAL
  LABORAL
  ADMINISTRATIVO
  FISCAL
  FAMILIA
  COMERCIAL
  OUTRO
}

enum MatterStatus {
  ATIVO
  ENCERRADO
  SUSPENSO
  ARQUIVADO
}

enum SignatureType {
  NONE
  SES
  AES
  QES
}

enum SignatureStatus {
  PENDING
  SIGNED
  REJECTED
}

enum SignatureProvider {
  AUTENTICACAO_GOV
  MULTICERT
  DOCUSIGN
}

enum TaskType {
  PRAZO
  AUDIENCIA
  DILIGENCIA
  REUNIAO
  OUTRO
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum LegalDocumentType {
  LEI
  DECRETO
  ACORDAO
  RESOLUCAO
  PORTARIA
  OUTRO
}

enum ExpenseCategory {
  DESLOCACAO
  TAXA_JUSTICA
  FOTOCOPIAS
  CORREIO
  OUTRO
}
