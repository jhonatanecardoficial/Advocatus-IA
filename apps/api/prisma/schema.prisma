// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// MULTI-TENANCY — Cada firma de advocacia é um Tenant
// ============================================================
model Tenant {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  plan          TenantPlan    @default(SOLO)
  logoUrl       String?
  settings      Json          @default("{}")
  billingStatus BillingStatus @default(TRIAL)
  
  // Detalhes Fiscais (SAF-T PT)
  nif                    String?
  address                String?
  postalCode             String?
  city                   String?
  phone                  String?
  email                  String?
  commercialRegistration String? // Conservatória / Registo Comercial

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  users          User[]
  clients        Client[]
  matters        Matter[]
  documents      Document[]
  tasks          Task[]
  invoices       Invoice[]
  messages       Message[]
  auditLogs      AuditLog[]
  expenses       Expense[]
  portalAccesses PortalAccess[]
  invoiceSeries  InvoiceSeries[]
  signedDocuments SignedDocument[]
  legalTemplates  LegalTemplate[]

  @@map("tenants")
}

// ============================================================
// UTILIZADORES com RBAC granular
// ============================================================
model User {
  id             String    @id @default(cuid())
  tenantId       String
  email          String
  name           String
  barNumber      String? // Nº Ordem dos Advogados
  role           UserRole  @default(ADVOGADO)
  avatarUrl      String?
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String? // Encriptado
  lastLoginAt    DateTime?
  passwordHash   String?
  supabaseUserId String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant             Tenant         @relation(fields: [tenantId], references: [id])
  assignedTasks      Task[]         @relation("TaskAssignee")
  createdTasks       Task[]         @relation("TaskCreator")
  timeEntries        TimeEntry[]
  auditLogs          AuditLog[]
  sentMessages       Message[]
  expenses           Expense[]
  createdPortalLinks PortalAccess[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ============================================================
// CLIENTES do escritório (pessoas singulares ou coletivas)
// ============================================================
model Client {
  id                  String     @id @default(cuid())
  tenantId            String
  type                ClientType @default(SINGULAR)
  name                String
  nif                 String?
  email               String?
  phone               String?
  address             String?
  conflictCheckStatus String?
  gdprConsentAt       DateTime?
  notes               String?
  deletedAt           DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  matters  Matter[]
  invoices Invoice[]

  @@unique([tenantId, nif])
  @@index([tenantId])
  @@map("clients")
}

// ============================================================
// PROCESSOS / MATTERS
// ============================================================
model Matter {
  id              String       @id @default(cuid())
  tenantId        String
  clientId        String
  responsibleId   String?
  title           String
  type            MatterType   @default(OUTRO)
  status          MatterStatus @default(ATIVO)
  courtReference  String?
  citiusReference String? // Referência manual inserida pelo advogado
  opposingParty   String?
  opposingCounsel String?
  description     String?
  openedAt        DateTime     @default(now())
  deadlineAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  client         Client         @relation(fields: [clientId], references: [id])
  documents      Document[]
  tasks          Task[]
  timeEntries    TimeEntry[]
  invoices       Invoice[]
  messages       Message[]
  expenses       Expense[]
  portalAccesses PortalAccess[]
  signedDocuments SignedDocument[]

  @@index([tenantId])
  @@map("matters")
}

// ============================================================
// DOCUMENTOS com versionamento e assinatura digital eIDAS
// ============================================================
model Document {
  id                 String             @id @default(cuid())
  matterId           String
  tenantId           String
  uploadedById       String?
  filename           String
  mimeType           String
  storagePath        String // Supabase Storage path
  sizeBytes          Int
  version            Int                @default(1)
  parentVersionId    String?
  signatureType      SignatureType      @default(NONE)
  signatureStatus    SignatureStatus?
  signatureProvider  SignatureProvider?
  signatureMetadata  Json? // Certificado, timestamp, cadeia validação
  ltaPreserved       Boolean            @default(false) // Long Term Archival
  isSharedWithClient Boolean            @default(false) // Visibilidade no portal do cliente
  tags               String[]
  metadata           Json               @default("{}")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  matter        Matter     @relation(fields: [matterId], references: [id])
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  parentVersion Document?  @relation("DocumentVersions", fields: [parentVersionId], references: [id])
  versions      Document[] @relation("DocumentVersions")
  signedDocuments SignedDocument[]

  @@index([tenantId])
  @@map("documents")
}

model SignedDocument {
  id                 String   @id @default(cuid())
  tenantId           String
  matterId           String?
  documentId         String? // Relacionamento opcional com o Document original
  originalFilePath   String // Caminho no Supabase Storage
  signedFilePath     String? // Caminho do PDF assinado final
  signerName         String? // Nome extraído do CC/CMD
  signerNif          String? // NIF do signatário
  signatureTimestamp DateTime @default(now())
  signatureValid     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  matter   Matter? @relation(fields: [matterId], references: [id])
  document Document? @relation(fields: [documentId], references: [id])

  @@index([tenantId])
  @@map("signed_documents")
}

// ============================================================
// TIME TRACKING — Horas faturáveis por matter
// ============================================================
model TimeEntry {
  id           String   @id @default(cuid())
  matterId     String
  userId       String
  tenantId     String // Redundante mas útil para RLS
  description  String
  hours        Decimal  @db.Decimal(5, 2)
  ratePerHour  Decimal? @db.Decimal(10, 2)
  billable     Boolean  @default(true)
  activityDate DateTime @db.Date
  invoiceId    String?
  taskId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  matter Matter @relation(fields: [matterId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  task   Task?  @relation(fields: [taskId], references: [id])

  @@index([tenantId])
  @@map("time_entries")
}

// ============================================================
// DESPESAS — Custos adicionais do processo
// ============================================================
model Expense {
  id          String          @id @default(cuid())
  tenantId    String
  matterId    String
  userId      String
  taskId      String?
  description String
  category    ExpenseCategory @default(OUTRO)
  amount      Decimal         @db.Decimal(10, 2)
  date        DateTime        @db.Date
  billable    Boolean         @default(true)
  invoiceId   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  matter Matter @relation(fields: [matterId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  task   Task?  @relation(fields: [taskId], references: [id])

  @@index([tenantId])
  @@map("expenses")
}

// ============================================================
// FATURAS
// ============================================================
model Invoice {
  id          String        @id @default(cuid())
  matterId    String
  clientId    String
  tenantId    String
  reference   String        @unique // ex: FS 2024/1
  series      String        @default("A")
  number      Int           @default(0)
  amount      Decimal       @db.Decimal(10, 2)
  vatRate     Decimal       @default(23) @db.Decimal(5, 2)
  total       Decimal       @db.Decimal(10, 2)
  status      InvoiceStatus @default(DRAFT)
  dueDate     DateTime?
  paidAt      DateTime?
  notes       String?
  
  // Campos de Certificação AT
  hash        String?       // Hash de encadeamento
  hashControl String?       // 4 caracteres da assinatura
  signature   String?       // Assinatura digital RSA
  atcud       String?       // Código Único de Documento
  keyVersion  Int           @default(1)
  isCertified Boolean       @default(false)
  certDate    DateTime?     // Data/Hora da certificação

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  matter Matter @relation(fields: [matterId], references: [id])
  client Client @relation(fields: [clientId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("invoices")
}

model InvoiceSeries {
  id         String   @id @default(cuid())
  tenantId   String
  code       String   // ex: "A", "2024"
  type       String   @default("FT") // FT, FS, NC, ND
  nextNumber Int      @default(1)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@map("invoice_series")
}

// ============================================================
// TAREFAS e PRAZOS processuais
// ============================================================
model Task {
  id               String       @id @default(cuid())
  matterId         String
  assignedToId     String?
  createdById      String
  tenantId         String
  title            String
  description      String?
  type             TaskType     @default(OUTRO)
  priority         TaskPriority @default(MEDIA)
  dueAt            DateTime?
  penaltyLimitAt   DateTime?
  completedAt      DateTime?
  notificationSent Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  matter      Matter      @relation(fields: [matterId], references: [id])
  assignedTo  User?       @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy   User        @relation("TaskCreator", fields: [createdById], references: [id])
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  timeEntries TimeEntry[]
  expenses    Expense[]

  @@index([tenantId])
  @@map("tasks")
}

// ============================================================
// MENSAGENS encriptadas — comunicação com clientes
// ============================================================
model Message {
  id               String    @id @default(cuid())
  matterId         String
  senderId         String?
  tenantId         String
  contentEncrypted String // AES-256
  readAt           DateTime?
  isFromClient     Boolean   @default(false)
  createdAt        DateTime  @default(now())

  matter Matter @relation(fields: [matterId], references: [id])
  sender User?  @relation(fields: [senderId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("messages")
}

// ============================================================
// LOGS DE AUDITORIA — imutáveis (append-only)
// ============================================================
model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String?
  action       String
  resourceType String
  resourceId   String
  oldValue     Json?
  newValue     Json?
  ipAddress    String?
  userAgent    String?
  timestamp    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("audit_logs")
}

// ============================================================
// BASE DE CONHECIMENTO LEGAL — para RAG/IA
// ============================================================
model LegalDocument {
  id          String                       @id @default(cuid())
  source      String // dados.gov.pt | dre.pt | manual
  type        LegalDocumentType
  title       String
  reference   String?
  content     String                       @db.Text
  embedding   Unsupported("vector(1536)")?
  publishedAt DateTime?
  url         String?
  ingestedAt  DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@map("legal_documents")
}

// ============================================================
// PORTAL DE ACESSO — Links seguros para clientes
// ============================================================
model PortalAccess {
  id        String   @id @default(cuid())
  tenantId  String
  matterId  String
  token     String   @unique
  expiresAt DateTime
  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  matter Matter @relation(fields: [matterId], references: [id])
  user   User   @relation(fields: [createdBy], references: [id])

  @@index([tenantId])
  @@index([token])
  @@map("portal_accesses")
}

// ============================================================
// TEMPLATES JURÍDICOS — Para automação de geração de peças
// ============================================================
model LegalTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  category    String   // ex: Procuração, Requerimento, Petição
  content     String   @db.Text // Texto base com placeholders {{var}}
  placeholders String[] // Lista de variáveis detectadas para auxílio na UI
  aiPrompt    String?  @db.Text // Instruções específicas para IA ao refinar
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("legal_templates")
}

// ============================================================
// ENUMS
// ============================================================
enum UserRole {
  ADMIN
  SOCIO
  ADVOGADO
  ESTAGIARIO
  SECRETARIA
  CLIENTE
}

enum TenantPlan {
  SOLO
  PEQUENO
  ESCRITORIO
  ENTERPRISE
}

enum BillingStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum ClientType {
  SINGULAR
  COLETIVO
}

enum MatterType {
  CIVEL
  PENAL
  LABORAL
  ADMINISTRATIVO
  FISCAL
  FAMILIA
  COMERCIAL
  OUTRO
}

enum MatterStatus {
  ATIVO
  ENCERRADO
  SUSPENSO
  ARQUIVADO
}

enum SignatureType {
  NONE
  SES
  AES
  QES
}

enum SignatureStatus {
  PENDING
  SIGNED
  REJECTED
}

enum SignatureProvider {
  AUTENTICACAO_GOV
  MULTICERT
  DOCUSIGN
}

enum TaskType {
  PRAZO
  AUDIENCIA
  DILIGENCIA
  REUNIAO
  OUTRO
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum LegalDocumentType {
  LEI
  DECRETO
  ACORDAO
  RESOLUCAO
  PORTARIA
  OUTRO
}

enum ExpenseCategory {
  DESLOCACAO
  TAXA_JUSTICA
  FOTOCOPIAS
  CORREIO
  OUTRO
}
